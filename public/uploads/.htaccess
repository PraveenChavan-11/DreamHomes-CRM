# ==============================================================================
# TalentHub Consultant — Upload Directory Protection
# Prevents execution of scripts and limits access to safe media formats
# ==============================================================================

Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .cgi .pl .py
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .cgi .pl .py

<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|inc|cgi|pl|py|sh|bash|exe|cmd|bat)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

<FilesMatch "(?i)\.(jpg|jpeg|png|gif|webp|svg|ico|pdf|doc|docx)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>
