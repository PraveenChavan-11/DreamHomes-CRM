# ─────────────────────────────────────────────────────────────────────────────
# DHIS Sales CRM — environment template.  Copy to `.env` on the server.
# NEVER commit the real .env.  All values below are placeholders.
# (Other TalentHub keys are documented in the existing `env` / `env.staging`
#  templates; only the keys the CRM needs are listed here.)
# ─────────────────────────────────────────────────────────────────────────────

CI_ENVIRONMENT = production          # production | development (never "development" on a public server)
app.baseURL = 'https://crm.example.com/'

# ── Database (MariaDB 10.4+ / MySQL 8, utf8mb4) ──
database.default.hostname = 127.0.0.1
database.default.database = your_database_name
database.default.username = your_database_user
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.port = 3306

# ── Encryption / session (generate with: php spark key:generate) ──
encryption.key =

# ── Demo mode — set to true ONLY on the designated demo server ──
# Demo reset and demo seeding refuse to run unless this is true AND the CRM
# setting demo.enabled = 1. Leave empty/false on production.
DHIS_DEMO_ENV = false

# ── Outgoing e-mail ──
# The CRM setting email.mode controls whether anything is actually sent:
#   log_only (default) = record only, never contacts the recipient
#   smtp               = transmit through the server below (demo records are never transmitted)
email.fromEmail = crm@example.com
email.fromName = 'DHIS Sales CRM'
email.protocol = smtp
email.SMTPHost = smtp.example.com
email.SMTPUser = crm@example.com
email.SMTPPass = CHANGE_ME
email.SMTPPort = 465
email.SMTPCrypto = ssl
