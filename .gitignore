!/writable/uploads/index.html
/writable/vault/resumes/*
!/writable/vault/resumes/.gitkeep
!/writable/vault/resumes/index.html
!/writable/vault/.gitkeep
!/writable/.gitkeep
!/writable/.htaccess
!/writable/index.html

